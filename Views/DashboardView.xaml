<UserControl x:Class="Sachiel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Margin="25">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<TextBlock Text="Bienvenido" FontSize="30" FontWeight="Bold"/>
			<TextBlock Text="Resumen general de Sachiel" FontSize="16" Foreground="Gray"/>
		</StackPanel>

		
		<!-- CARDS -->
		<UniformGrid Grid.Row="1" Columns="4" Margin="0,25">

            <Border Margin="5" Padding="15" BorderThickness="1" BorderBrush="LightGray" Cursor="Hand" MouseLeftButtonUp="CardProductos_Click" ToolTip="Ver todos los productos">
				<StackPanel>
					<TextBlock Text="📦 Productos" FontSize="18"/>
					<TextBlock x:Name="txtProductos" Text="0" FontSize="32" FontWeight="Bold"/>
				</StackPanel>
			</Border>

            <Border Margin="5" Padding="15" BorderThickness="1" BorderBrush="LightGray" Cursor="Hand" MouseLeftButtonUp="CardVentas_Click" ToolTip="Ver ventas (15 días)">
				<StackPanel>
					<TextBlock Text="🛒 Ventas semana" FontSize="18"/>
					<TextBlock x:Name="txtVentas" Text="0" FontSize="32" FontWeight="Bold"/>
				</StackPanel>
			</Border>

			<Border Margin="5" Padding="15" BorderThickness="1" BorderBrush="LightGray">
				<StackPanel>
					<TextBlock Text="💰 Ingresos semana" FontSize="18"/>
					<TextBlock x:Name="txtIngresos" Text="$0" FontSize="32" FontWeight="Bold"/>
				</StackPanel>
			</Border>

            <Border Margin="5" Padding="15" BorderThickness="1" BorderBrush="LightGray" Cursor="Hand" MouseLeftButtonUp="CardPendientes_Click" ToolTip="Ver ventas sin facturar (15 días)">
				<StackPanel>
					<TextBlock Text="⚠ Sin facturar" FontSize="18"/>
					<TextBlock x:Name="txtPendientes" Text="0" FontSize="32" FontWeight="Bold"/>
				</StackPanel>
			</Border>

		</UniformGrid>

		
		<!-- VENTAS RECIENTES -->
		<GroupBox Grid.Row="2" Header="Ventas recientes" FontSize="18">
			<DataGrid x:Name="dgVentasRecientes" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" GridLinesVisibility="None">
				<DataGrid.Columns>

					<DataGridTextColumn Header="Código" Binding="{Binding Id, StringFormat=X4}" Width="80"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=yyMMdd}" Width="100"/>
					<DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="100" />
					<DataGridTextColumn Header="Productos" Binding="{Binding ResumenProductos}" Width="*"/>
					<DataGridTextColumn Header="Total" Binding="{Binding PrecioTotal, StringFormat=C}" Width="120"/>

				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		
		<!-- ACCIONES RÁPIDAS-->
		<StackPanel Grid.Row="3" Margin="0,25,0,0">
			<TextBlock Text="Acciones rápidas" FontSize="20" FontWeight="Bold"/>
			<WrapPanel Margin="0,10,0,0">
				
				<Button Content="+ Nueva venta" Width="140" Margin="5" Click="btnNuevaVenta_Click"/>
                <Button Content="+ Producto" Width="140" Margin="5" Click="btnNuevoProducto_Click"/>
                <Button Content="Exportar ventas" Width="140" Margin="5" Click="btnExportar_Click"/>
                <Button Content="Importar precios" Width="140" Margin="5" Click="btnImportar_Click"/>

			</WrapPanel>
		</StackPanel>

	</Grid>
</UserControl>