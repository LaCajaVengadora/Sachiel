<UserControl x:Class="Sachiel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Margin="25">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<TextBlock Text="Bienvenido" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Black}"/>
			<TextBlock Text="Resumen general de Sachiel" FontSize="16" Foreground="Gray"/>
		</StackPanel>

		
		<!-- CARDS -->
		<UniformGrid Grid.Row="1" Columns="4" Margin="0,25">

            <Border Margin="5"  Style="{StaticResource borderCard}" MouseLeftButtonUp="CardProductos_Click" ToolTip="Ver todos los productos">
				<StackPanel>
					<TextBlock Text="📦 Productos" FontWeight="Bold" FontSize="18" Foreground="{StaticResource LightGray}"/>
					<TextBlock x:Name="txtProductos" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource LightGray}"/>
				</StackPanel>
			</Border>

            <Border Margin="5" Style="{StaticResource borderCard}" MouseLeftButtonUp="CardVentas_Click" ToolTip="Ver ventas (15 días)">
				<StackPanel>
                    <TextBlock Text="🛒 Ventas semana" FontSize="18" FontWeight="Bold" Foreground="{StaticResource LightGray}"/>
                    <TextBlock x:Name="txtVentas" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource LightGray}"/>
				</StackPanel>
			</Border>

            <Border Margin="5" Style="{StaticResource borderCard}" Cursor="No">
				<StackPanel>
                    <TextBlock Text="💰 Ingresos semana" FontSize="18" FontWeight="Bold" Foreground="{StaticResource LightGray}"/>
                    <TextBlock x:Name="txtIngresos" Text="$0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource LightGray}"/>
				</StackPanel>
			</Border>

            <Border Margin="5" Style="{StaticResource borderCardFact}" MouseLeftButtonUp="CardPendientes_Click" ToolTip="Ver ventas sin facturar (15 días)">
				<StackPanel>
                    <TextBlock Text="⚠ Sin facturar" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Black}"/>
                    <TextBlock x:Name="txtPendientes" Text="0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Black}"/>
				</StackPanel>
			</Border>

		</UniformGrid>

		
		<!-- VENTAS RECIENTES -->
        <GroupBox Grid.Row="2" FontSize="16">
            <GroupBox.Header>
                <TextBlock Text="Ventas recientes" FontWeight="Bold" FontSize="20" Foreground="{StaticResource SecBlack}"/>
            </GroupBox.Header>
            <DataGrid x:Name="dgVentasRecientes" ColumnHeaderStyle="{StaticResource HeaderDataGrid}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" GridLinesVisibility="None">
                <DataGrid.Columns>

					<DataGridTextColumn Header="Código" Binding="{Binding Id, StringFormat=X4}" Width="80"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=yyMMdd}" Width="100"/>
					<DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="100" />
					<DataGridTextColumn Header="Productos" Binding="{Binding ResumenProductos}" Width="*"/>
					<DataGridTextColumn Header="Total" Binding="{Binding PrecioTotal, StringFormat=C}" Width="120"/>

				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		
		<!-- ACCIONES RÁPIDAS-->
		<StackPanel Grid.Row="3" Margin="0,25,0,0">
            <TextBlock Text="Acciones rápidas" FontSize="20" Foreground="{StaticResource SecBlack}" FontWeight="Bold"/>
			<WrapPanel Margin="0,10,0,0">
				
				<Button Content="+ Nueva venta" Style="{StaticResource btnBig}" Margin="5" Click="btnNuevaVenta_Click"/>
                <Button Content="+ Producto" Style="{StaticResource btnBig}" Margin="5" Click="btnNuevoProducto_Click"/>
                <Button Content="Exportar ventas" Style="{StaticResource btnBig}" Margin="5" Click="btnExportar_Click"/>
                <Button Content="Importar precios" Style="{StaticResource btnBig}" Margin="5" Click="btnImportar_Click"/>

			</WrapPanel>
		</StackPanel>

	</Grid>
</UserControl>