<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="DarkGreen" Color="#2C5F1E"/>
    <SolidColorBrush x:Key="Green" Color="#398033"/>
    <SolidColorBrush x:Key="Gold" Color="#cfaf4a"/>
    <SolidColorBrush x:Key="LightGray" Color="#e5e6eb"/>
    <SolidColorBrush x:Key="White" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="Black" Color="#2b3333"/>
    <SolidColorBrush x:Key="SecBlack" Color="#4c5959"/>
    <!--
    COLORS
    darkgreen: #2c5f1e
    green: 398033
    gold: cfaf4a
    lightgray: e5e6eb
    white: f8f9fa
    black: 2b3333
    secondaryblack: 4c5959
    -->


    <Style x:Key="btnSidebar" TargetType="Button">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="20,0,20,15"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{StaticResource LightGray}"/>
    </Style>
    <Style x:Key="borderBtn" TargetType="Border">
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Padding" Value="25,5"/>
        <Setter Property="Background" Value="{StaticResource LightGray}"/>
    </Style>




    
    
    
</ResourceDictionary>